---
import '../styles/global.css';
import T from '../components/T.astro';

interface Props { title?: string; description?: string; path?: string; type?: 'website' | 'article'; jsonLd?: object }
const SITE = 'https://apnews.mahidhardurga.in';
const {
  title,
  description = 'Latest Andhra Pradesh news headlines from many outlets, in English and Telugu, filterable by topic and district. Every headline opens the original article on the publisher site.',
  path = Astro.url.pathname,
  type = 'website',
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} · AP News` : 'AP News – Andhra Pradesh headlines, by topic and district';
const canonical = new URL(path, SITE).toString();
const ogImage = `${SITE}/og.png`;
const nav = [
  { href: '/', en: 'Headlines', te: 'శీర్షికలు' },
  { href: '/districts/', en: 'Districts', te: 'జిల్లాలు' },
  { href: '/about/', en: 'About', te: 'గురించి' },
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AP News headlines" href="/rss.xml" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="AP News" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Telugu:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Runs before paint: no flash of wrong theme/language.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
        var l = localStorage.getItem('lang');
        if (l === 'te' || l === 'en') { document.documentElement.dataset.lang = l; document.documentElement.lang = l; }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-20 border-b border-black/5 bg-white/60 backdrop-blur-2xl backdrop-saturate-200 dark:border-white/10 dark:bg-black/55">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5">
        <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="AP News home">
          <span class="grid h-8 w-8 place-items-center rounded-[10px] bg-gradient-to-br from-[#0071e3] via-[#7c3aed] to-[#ec4899] text-[13px] font-extrabold tracking-tight text-white shadow-md shadow-indigo-500/30" aria-hidden="true">AP</span>
          <span class="flex items-baseline gap-2">
            <span class="text-lg font-bold tracking-tight">AP News</span>
            <span class="hidden text-sm muted min-[440px]:inline" lang="te">ఏపీ న్యూస్</span>
          </span>
        </a>
        <div class="flex items-center gap-2">
          <p id="visitors" hidden title="Readers so far"
             class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-accent/10 px-3 py-1.5 text-sm font-medium text-accent dark:bg-accent-dark/15 dark:text-accent-dark">
            <span aria-hidden="true">👥</span>
            <span><span data-n class="font-semibold"></span><span class="hidden sm:inline"> <span class="l-en" data-unit>readers</span><span class="l-te" lang="te">పాఠకులు</span></span></span>
          </p>
          <button id="lang-toggle" class="btn !px-2.5" type="button" aria-label="Switch language / భాష మార్చండి">
            <span class="l-en" lang="te">తెలుగు</span><span class="l-te">English</span>
          </button>
          <button id="theme-toggle" class="btn !px-2.5" type="button" aria-label="Toggle dark mode">
            <span class="dark:hidden" aria-hidden="true">🌙</span><span class="hidden dark:inline" aria-hidden="true">☀️</span>
          </button>
        </div>
      </div>
      <nav class="mx-auto max-w-6xl overflow-x-auto px-4 pb-2" aria-label="Main">
        <ul class="flex gap-1 text-sm whitespace-nowrap">
          {nav.map((n) => (
            <li>
              <a href={n.href} aria-current={(n.href === '/' ? here === '/' : here.startsWith(n.href)) ? 'page' : undefined}
                 class="block rounded-full px-3.5 py-1.5 no-underline text-[#6e6e73] hover:bg-black/5 dark:text-[#98989d] dark:hover:bg-white/10 aria-[current=page]:bg-black/[.07] aria-[current=page]:font-semibold aria-[current=page]:text-[#1d1d1f] dark:aria-[current=page]:bg-white/15 dark:aria-[current=page]:text-white">
                <T en={n.en} te={n.te} />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-5">
      <slot />
    </main>

    <footer class="mt-8 border-t border-black/5 bg-white/40 py-8 text-xs muted backdrop-blur-xl dark:border-white/10 dark:bg-white/[.03]">
      <div class="mx-auto max-w-6xl space-y-2 px-4">
        <p class="flex items-center gap-2 text-sm font-semibold text-[#1d1d1f] dark:text-white">
          <span class="grid h-5 w-5 place-items-center rounded-md bg-gradient-to-br from-[#0071e3] to-[#7c3aed] text-[9px] font-extrabold text-white" aria-hidden="true">AP</span> AP News
        </p>
        <p>
          <T en="AP News is an automated aggregator. Headlines and short excerpts belong to their publishers; every story links to the original article."
             te="ఏపీ న్యూస్ ఒక ఆటోమేటెడ్ అగ్రిగేటర్. శీర్షికలు, చిన్న సారాంశాలు ఆయా ప్రచురణకర్తలకే చెందుతాయి; ప్రతి వార్త అసలు కథనానికి లింక్ చేస్తుంది." />
        </p>
        <p><a href="/about/" class="underline"><T en="Methodology" te="పద్ధతి" /></a> · <a href="/rss.xml" class="underline">RSS</a> · <a href="/sitemap.xml" class="underline">Sitemap</a> ·
          <button type="button" id="consent-open" class="underline"><T en="Privacy choices" te="గోప్యతా ఎంపికలు" /></button></p>
      </div>
    </footer>

    <!-- Analytics consent: Google Analytics loads only after the visitor accepts. -->
    <div id="consent" hidden role="dialog" aria-label="Analytics consent"
         class="fixed inset-x-3 bottom-3 z-40 mx-auto max-w-xl rounded-2xl border border-black/5 bg-white/90 p-4 shadow-2xl backdrop-blur-xl dark:border-white/10 dark:bg-[#2c2c2e]/90">
      <p class="text-sm">
        <T en="We use Google Analytics (cookies) to count visits and see which pages are used. Nothing is collected unless you accept."
           te="సందర్శనలను లెక్కించడానికి, ఏ పేజీలు వాడుతున్నారో తెలుసుకోవడానికి మేము Google Analytics (కుకీలు) వాడతాం. మీరు అంగీకరిస్తే తప్ప ఏమీ సేకరించం." />
        {" "}<a href="/about/#privacy" class="underline"><T en="Details" te="వివరాలు" /></a>
      </p>
      <div class="mt-3 flex justify-end gap-2">
        <button type="button" id="consent-no" class="btn"><T en="Decline" te="తిరస్కరించు" /></button>
        <button type="button" id="consent-yes" class="btn !border-transparent !bg-accent !text-white hover:!bg-accent/90"><T en="Accept" te="అంగీకరించు" /></button>
      </div>
    </div>

    <script>
      import { showVisitors } from '../scripts/visitors';

      const root = document.documentElement;
      showVisitors(document.getElementById('visitors')!);
      document.getElementById('lang-toggle')?.addEventListener('click', () => {
        const next = root.dataset.lang === 'te' ? 'en' : 'te';
        root.dataset.lang = next;
        root.lang = next;
        try { localStorage.setItem('lang', next); } catch {}
        window.dispatchEvent(new Event('langchange'));
      });
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });

      // --- Google Analytics (GA4), only after consent ---
      const GA_ID = 'G-RLLBZJKNY3';
      const banner = document.getElementById('consent')!;
      const getConsent = () => { try { return localStorage.getItem('consent'); } catch { return null; } };
      const setConsent = (v: 'granted' | 'denied') => { try { localStorage.setItem('consent', v); } catch {} };

      function loadAnalytics() {
        if (['localhost', '127.0.0.1'].includes(location.hostname)) return; // keep dev visits out of the stats
        if ((window as any).__gaLoaded) return;
        (window as any).__gaLoaded = true;
        const w = window as any;
        w.dataLayer = w.dataLayer || [];
        function gtag(..._args: unknown[]) { w.dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA_ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
        const s = document.createElement('script');
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
        document.head.appendChild(s);
      }

      if (getConsent() === 'granted') loadAnalytics();
      else if (getConsent() !== 'denied') banner.hidden = false;

      document.getElementById('consent-yes')?.addEventListener('click', () => { setConsent('granted'); banner.hidden = true; loadAnalytics(); });
      document.getElementById('consent-no')?.addEventListener('click', () => { setConsent('denied'); banner.hidden = true; });
      document.getElementById('consent-open')?.addEventListener('click', () => { banner.hidden = false; });
    </script>
  </body>
</html>
