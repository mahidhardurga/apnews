---
import '../styles/global.css';
import T from '../components/T.astro';

interface Props { title?: string; description?: string; path?: string; type?: 'website' | 'article'; jsonLd?: object }
const SITE = 'https://apnews.mahidhardurga.in';
const {
  title,
  description = 'Latest Andhra Pradesh news headlines from many outlets, in English and Telugu, filterable by topic and district. Every headline opens the original article on the publisher site.',
  path = Astro.url.pathname,
  type = 'website',
  jsonLd,
} = Astro.props;
const fullTitle = title ? `${title} · AP News` : 'AP News – Andhra Pradesh headlines, by topic and district';
const canonical = new URL(path, SITE).toString();
const ogImage = `${SITE}/og.png`;
const nav = [
  { href: '/', en: 'Headlines', te: 'శీర్షికలు' },
  { href: '/districts/', en: 'Districts', te: 'జిల్లాలు' },
  { href: '/about/', en: 'About', te: 'గురించి' },
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="AP News headlines" href="/rss.xml" />
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="AP News" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+Telugu:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      // Runs before paint: no flash of wrong theme/language.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
        var l = localStorage.getItem('lang');
        if (l === 'te' || l === 'en') { document.documentElement.dataset.lang = l; document.documentElement.lang = l; }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-20 border-b border-black/5 bg-[#f5f5f7]/80 backdrop-blur-xl backdrop-saturate-150 dark:border-white/10 dark:bg-black/70">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-2.5">
        <a href="/" class="flex items-baseline gap-2 no-underline">
          <span class="text-lg font-bold tracking-tight text-accent dark:text-accent-dark">AP News</span>
          <span class="text-sm muted" lang="te">ఏపీ న్యూస్</span>
        </a>
        <div class="flex items-center gap-2">
          <button id="lang-toggle" class="btn !px-2.5" type="button" aria-label="Switch language / భాష మార్చండి">
            <span class="l-en" lang="te">తెలుగు</span><span class="l-te">English</span>
          </button>
          <button id="theme-toggle" class="btn !px-2.5" type="button" aria-label="Toggle dark mode">
            <span class="dark:hidden" aria-hidden="true">🌙</span><span class="hidden dark:inline" aria-hidden="true">☀️</span>
          </button>
        </div>
      </div>
      <nav class="mx-auto max-w-5xl overflow-x-auto px-4 pb-2" aria-label="Main">
        <ul class="flex gap-1 text-sm whitespace-nowrap">
          {nav.map((n) => (
            <li>
              <a href={n.href} aria-current={(n.href === '/' ? here === '/' : here.startsWith(n.href)) ? 'page' : undefined}
                 class="block rounded-full px-3.5 py-1.5 no-underline text-[#6e6e73] hover:bg-black/5 dark:text-[#98989d] dark:hover:bg-white/10 aria-[current=page]:bg-black/[.07] aria-[current=page]:font-semibold aria-[current=page]:text-[#1d1d1f] dark:aria-[current=page]:bg-white/15 dark:aria-[current=page]:text-white">
                <T en={n.en} te={n.te} />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-5">
      <slot />
    </main>

    <footer class="border-t border-black/5 py-6 text-xs muted dark:border-white/10">
      <div class="mx-auto max-w-5xl space-y-1 px-4">
        <p>
          <T en="AP News is an automated aggregator. Headlines and short excerpts belong to their publishers; every story links to the original article."
             te="ఏపీ న్యూస్ ఒక ఆటోమేటెడ్ అగ్రిగేటర్. శీర్షికలు, చిన్న సారాంశాలు ఆయా ప్రచురణకర్తలకే చెందుతాయి; ప్రతి వార్త అసలు కథనానికి లింక్ చేస్తుంది." />
        </p>
        <p><a href="/about/" class="underline"><T en="Methodology" te="పద్ధతి" /></a> · <a href="/rss.xml" class="underline">RSS</a> · <a href="/sitemap.xml" class="underline">Sitemap</a></p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById('lang-toggle')?.addEventListener('click', () => {
        const next = root.dataset.lang === 'te' ? 'en' : 'te';
        root.dataset.lang = next;
        root.lang = next;
        try { localStorage.setItem('lang', next); } catch {}
        window.dispatchEvent(new Event('langchange'));
      });
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
  </body>
</html>
