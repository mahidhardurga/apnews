---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
---
<Base>
  <section class="pb-2 pt-3 sm:pt-6">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
      <span class="grad-text"><T en="Andhra Pradesh news" te="ఆంధ్రప్రదేశ్ వార్తలు" /></span>
    </h1>
    <p class="mt-2 max-w-2xl text-[15px] muted sm:text-base">
      <T en="Headlines from many outlets in one place. Tap one to read it on the original site." te="వివిధ మీడియా సంస్థల శీర్షికలు ఒకే చోట. నొక్కితే అసలు వెబ్‌సైట్‌లో కథనం తెరుచుకుంటుంది." />
    </p>
    <div id="stats" class="mt-4 flex flex-wrap gap-2" aria-live="polite"></div>
  </section>

  <div class="z-10 -mx-4 mb-3 md:sticky md:top-[5.4rem] border-b border-black/5 bg-[#f5f5f7]/85 px-4 pb-3 pt-3 backdrop-blur-xl dark:border-white/10 dark:bg-black/75">
    <div class="search-wrap">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input id="q" type="search" class="input" autocomplete="off" />
    </div>
    <div id="filters" class="mt-2.5 flex flex-wrap items-center gap-2"></div>
  </div>
  <p id="count" class="mb-3 px-1 text-xs muted" aria-live="polite"></p>
  <div id="briefing"></div>

  <div id="list" class="grid gap-3 md:grid-cols-2" aria-busy="true">
    {[0, 1, 2, 3, 4, 5].map(() => <div class="skeleton"></div>)}
  </div>
  <div class="mt-6 text-center"><button id="more" type="button" class="btn !px-5 !py-2" hidden><T en="Load more" te="మరిన్ని" /></button></div>
</Base>

<script>
  import Fuse from 'fuse.js';
  import { esc, getJSON, ui, lang, timeAgo, dual, type Headline } from '../scripts/lib';
  import { districtLabel, topicLabel, TOPIC_ORDER } from '../lib/i18n';

  const PAGE = 40;
  const hue = (id: string) => [...id].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
  const shortName = (n: string) => n.replace(/\s*\(.*?\)\s*/g, ' ').replace(/^The /, '').trim();
  const initials = (n: string) => shortName(n).split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const list = $('list'), count = $('count'), more = $<HTMLButtonElement>('more'), q = $<HTMLInputElement>('q'), filtersEl = $('filters');

  let items: Headline[] = [];
  let fuse: Fuse<Headline>;
  let shown = PAGE;
  const sp = new URLSearchParams(location.search);
  const state = { topic: sp.get('topic') ?? '', district: sp.get('district') ?? '', source: sp.get('source') ?? '',
                  lang: sp.get('lang') ?? '', date: sp.get('date') ?? '', q: sp.get('q') ?? '' };
  type Key = keyof typeof state;
  q.value = state.q;

  // --- AI topic briefings (written by the scraper through OpenRouter; absent until a key is configured) ---
  interface TopicSummary { summary_en: string; summary_te: string; headline_count: number; updated: string }
  let summaries: Record<string, TopicSummary> = {};
  let briefOpen = false;
  const briefing = $('briefing');
  const sparkle = '<span aria-hidden="true">✨</span>';

  function renderBriefing() {
    const have = TOPIC_ORDER.filter((t) => summaries[t]);
    if (!have.length) { briefing.innerHTML = ''; return; }
    const note = (s: TopicSummary) => dual(
      `AI-written from ${s.headline_count} recent headlines. It can make mistakes.`,
      `${s.headline_count} తాజా శీర్షికల ఆధారంగా AI రాసింది. పొరపాట్లు ఉండవచ్చు.`);
    const one = state.topic ? summaries[state.topic] : undefined;
    if (state.topic && one) {
      briefing.innerHTML = `<section class="briefing-card mb-4">
        <p class="mb-1.5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-accent dark:text-accent-dark">${sparkle}
          ${dual('AI summary', 'AI సారాంశం')} · ${dual(...topicLabel(state.topic))}</p>
        <p class="leading-relaxed" lang="${lang()}">${dual(one.summary_en, one.summary_te)}</p>
        <p class="mt-2 text-xs muted">${note(one)} · ${timeAgo(one.updated)}</p></section>`;
    } else if (!state.topic) {
      briefing.innerHTML = `<details class="briefing-card mb-4" ${briefOpen ? 'open' : ''}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
          <span class="flex items-center gap-1.5">${sparkle} ${dual('Topic briefings', 'అంశాల సారాంశాలు')}
            <span class="text-xs font-normal muted">${dual('AI', 'AI')}</span></span>${chevron}</summary>
        <div class="mt-3 space-y-4">${have.map((t) => `<div>
          <button type="button" data-pick-topic="${t}" class="font-semibold text-accent dark:text-accent-dark">${dual(...topicLabel(t))}</button>
          <p class="mt-1 text-sm leading-relaxed">${dual(summaries[t]!.summary_en, summaries[t]!.summary_te)}</p>
          <p class="mt-1 text-xs muted">${timeAgo(summaries[t]!.updated)}</p></div>`).join('')}</div>
        <p class="mt-4 text-xs muted">${dual('Written by AI from the latest headlines in each topic. It can make mistakes.',
          'ప్రతి అంశంలోని తాజా శీర్షికల ఆధారంగా AI రాసింది. పొరపాట్లు ఉండవచ్చు.')}</p></details>`;
    } else {
      briefing.innerHTML = '';
    }
  }
  briefing.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('[data-pick-topic]') as HTMLElement | null;
    if (b) { state.topic = b.dataset.pickTopic ?? ''; refresh(); scrollTo({ top: 0, behavior: 'smooth' }); }
  });
  briefing.addEventListener('toggle', (e) => { briefOpen = (e.target as HTMLDetailsElement).open; }, true);

  interface Opt { v: string; label: string; n?: number }
  const chevron = '<svg width="12" height="8" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1.5l5 5 5-5"/></svg>';

  /** One Apple-style popover dropdown. `all` is the label of the "no filter" row. */
  function dropdown(k: Key, all: [string, string], opts: Opt[], allCount?: number): string {
    const te = ui('en', 'te') === 'te';
    const cur = opts.find((o) => o.v === state[k]);
    const row = (o: Opt) => `<button type="button" role="option" class="dd-opt" data-v="${esc(o.v)}" aria-selected="${state[k] === o.v}">
        <span class="tick">${state[k] === o.v ? '✓' : ''}</span><span>${o.label}</span>${o.n != null ? `<span class="n">${o.n}</span>` : ''}</button>`;
    return `<div class="relative" data-dd="${k}">
      <button type="button" class="dd-btn" aria-haspopup="listbox" aria-expanded="false" data-on="${!!cur}">
        <span>${cur ? cur.label : all[te ? 1 : 0]}</span>${chevron}</button>
      <div class="dd-menu hidden" role="listbox">${row({ v: '', label: all[te ? 1 : 0], n: allCount })}${opts.map(row).join('')}</div>
    </div>`;
  }

  function buildFilters() {
    const te = ui('en', 'te') === 'te';
    const tally = (get: (i: Headline) => string | null) => {
      const m = new Map<string, number>();
      items.forEach((i) => { const v = get(i); if (v) m.set(v, (m.get(v) ?? 0) + 1); });
      return m;
    };
    const topics = tally((i) => i.topic), districts = tally((i) => i.district), sources = tally((i) => i.source);
    const names = new Map(items.map((i) => [i.source, i.source_name]));
    const active = (Object.keys(state) as Key[]).some((k) => state[k].trim());

    filtersEl.innerHTML =
      dropdown('topic', ['All topics', 'అన్ని అంశాలు'],
        TOPIC_ORDER.filter((t) => topics.has(t)).map((t) => ({ v: t, label: dual(...topicLabel(t)), n: topics.get(t) })), items.length) +
      dropdown('district', ['All districts', 'అన్ని జిల్లాలు'],
        [...districts.keys()].sort().map((d) => ({ v: d, label: dual(...districtLabel(d)), n: districts.get(d) }))) +
      dropdown('source', ['All outlets', 'అన్ని మీడియా సంస్థలు'],
        [...sources.keys()].map((s) => ({ v: s, label: esc(names.get(s) ?? s), n: sources.get(s) }))) +
      dropdown('lang', ['Any language', 'ఏ భాషైనా'], [{ v: 'en', label: 'English' }, { v: 'te', label: 'తెలుగు' }]) +
      dropdown('date', ['Any time', 'ఎప్పుడైనా'], [{ v: '6h', label: ui('Last 6 hours', 'గత 6 గంటలు') }, { v: '24h', label: ui('Last 24 hours', 'గత 24 గంటలు') }, { v: '7d', label: ui('Last 7 days', 'గత 7 రోజులు') }]) +
      (active ? `<button type="button" id="reset" class="px-2 text-sm text-accent dark:text-accent-dark">${ui('Clear', 'తొలగించు')}</button>` : '');
    q.placeholder = ui('Search headlines', 'శీర్షికల కోసం వెతకండి');
  }

  function render() {
    renderBriefing();
    const term = state.q.trim();
    let res = term ? fuse.search(term).map((r) => r.item) : items;
    res = res.filter((i) =>
      (!state.topic || i.topic === state.topic) &&
      (!state.district || i.district === state.district) &&
      (!state.source || i.source === state.source) &&
      (!state.lang || i.language === state.lang) &&
      (!state.date || Date.now() - new Date(i.published).getTime() <= ({ '6h': 6, '24h': 24, '7d': 168 }[state.date] ?? 168) * 3600_000));
    count.textContent = ui(`${res.length} headlines`, `${res.length} శీర్షికలు`);
    list.setAttribute('aria-busy', 'false');
    list.innerHTML = res.length
      ? res.slice(0, shown).map((i, n) => `
        <a href="${esc(i.url)}" target="_blank" rel="noopener noreferrer" class="news-card t-${i.topic}" style="animation-delay:${Math.min(n, 12) * 25}ms">
          <span class="block text-[17px] font-semibold leading-snug" lang="${i.language}">${esc(i.title)}</span>
          <span class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1.5 text-xs muted">
            <span class="avatar" style="--h:${hue(i.source)}" aria-hidden="true">${initials(i.source_name)}</span>
            <span class="font-medium text-[#3a3a3c] dark:text-[#d1d1d6]">${esc(shortName(i.source_name))}</span>
            <span aria-hidden="true">·</span><span>${timeAgo(i.published)}</span>
            ${i.topic !== 'general' ? `<span class="tag">${dual(...topicLabel(i.topic))}</span>` : ''}
            ${i.district ? `<span class="tag-plain">${dual(...districtLabel(i.district))}</span>` : ''}
            <span class="go ml-auto text-base" aria-hidden="true">↗</span>
          </span>
        </a>`).join('')
      : `<p class="card muted md:col-span-2">${ui('No headlines match.', 'సరిపోయే శీర్షికలు లేవు.')}</p>`;
    more.hidden = res.length <= shown;
    const out = new URLSearchParams();
    (Object.keys(state) as Key[]).forEach((k) => state[k].trim() && out.set(k, state[k]));
    history.replaceState(null, '', out.size ? `?${out}` : location.pathname);
  }

  function renderStats() {
    const stats = $('stats');
    const outlets = new Set(items.map((i) => i.source)).size;
    const newest = items.reduce((m, i) => (i.published > m ? i.published : m), '');
    const chip = (html: string) => `<span class="stat-chip">${html}</span>`;
    stats.innerHTML = chip(`<span class="live-dot"></span>${dual('Live', 'లైవ్')}`) +
      chip(`<b>${new Intl.NumberFormat('en-IN').format(items.length)}</b> ${dual('headlines', 'శీర్షికలు')}`) +
      chip(`<b>${outlets}</b> ${dual('outlets', 'మీడియా సంస్థలు')}`) +
      (newest ? chip(`${dual('Updated', 'నవీకరణ')} ${timeAgo(newest)}`) : '');
  }

  const refresh = () => { shown = PAGE; buildFilters(); render(); };

  // dropdown behaviour: toggle, choose, click-outside, Escape
  const closeAll = () => filtersEl.querySelectorAll('.dd-menu').forEach((m) => {
    m.classList.add('hidden');
    m.previousElementSibling?.setAttribute('aria-expanded', 'false');
  });
  filtersEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('#reset')) { (Object.keys(state) as Key[]).forEach((k) => (state[k] = '')); q.value = ''; refresh(); return; }
    const opt = t.closest('.dd-opt') as HTMLElement | null;
    const wrap = t.closest('[data-dd]') as HTMLElement | null;
    if (!wrap) return;
    if (opt) { state[wrap.dataset.dd as Key] = opt.dataset.v ?? ''; refresh(); return; }
    const btn = wrap.querySelector('.dd-btn') as HTMLElement, menu = wrap.querySelector('.dd-menu') as HTMLElement;
    const wasOpen = !menu.classList.contains('hidden');
    closeAll();
    if (!wasOpen) {
      menu.classList.remove('hidden', 'flip');
      if (menu.getBoundingClientRect().right > innerWidth - 8) menu.classList.add('flip');
      btn.setAttribute('aria-expanded', 'true');
    }
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('[data-dd]')) closeAll(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

  let t: number;
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(() => { state.q = q.value; refresh(); }, 150); });
  more.addEventListener('click', () => { shown += PAGE; render(); });
  window.addEventListener('langchange', () => { buildFilters(); render(); renderStats(); });

  getJSON<{ topics?: Record<string, TopicSummary> }>('topic_summaries.json')
    .then((d) => { summaries = d.topics ?? {}; renderBriefing(); })
    .catch(() => { /* no briefings yet: the page works without them */ });

  getJSON<{ articles: Headline[] }>('latest.json')
    .then((d) => {
      items = (d.articles ?? []).map((a) => ({ ...a, topic: a.topic ?? 'general', district: a.district ?? null }));
      fuse = new Fuse(items, { keys: ['title', 'source_name'], threshold: 0.3, ignoreLocation: true, minMatchCharLength: 2 });
      buildFilters(); render(); renderStats();
    })
    .catch(() => {
      list.setAttribute('aria-busy', 'false');
      list.innerHTML = `<p class="card muted md:col-span-2">${ui('No headlines yet — the first scrape may not have run.', 'ఇంకా శీర్షికలు లేవు — మొదటి స్క్రేప్ ఇంకా జరగకపోవచ్చు.')}</p>`;
    });
</script>
