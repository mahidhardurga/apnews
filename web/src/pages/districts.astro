---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
---
<Base title="District map" description="Andhra Pradesh news by district: an interactive map showing where the headlines are." path="/districts/">
  <section class="pb-2 pt-3 sm:pt-6">
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">
      <span class="grad-text"><T en="News by district" te="జిల్లాల వారీగా వార్తలు" /></span>
    </h1>
    <p class="mt-2 max-w-2xl text-[15px] muted sm:text-base">
      <T en="Each tile takes the colour of the most common topic in that district; stronger colour means more headlines. Select a district to read them."
         te="ప్రతి టైల్ ఆ జిల్లాలో ఎక్కువగా ఉన్న అంశం రంగులో ఉంటుంది; ముదురు రంగు అంటే ఎక్కువ శీర్షికలు. జిల్లాను ఎంచుకుని చదవండి." />
    </p>
    <div id="stats" class="mt-4 flex flex-wrap gap-2" aria-live="polite"></div>
  </section>

  <div class="my-4 flex flex-wrap items-center gap-3">
    <label class="flex items-center gap-2 text-sm"><span class="muted"><T en="Topic" te="అంశం" /></span>
      <select id="topic" class="input !w-auto !rounded-full !py-2"></select></label>
    <div id="legend" class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs muted"></div>
  </div>

  <div class="grid gap-4 lg:grid-cols-[minmax(0,1.75fr)_minmax(0,1fr)]">
    <div class="map-card overflow-x-auto"><svg id="map" viewBox="0 0 748 536" role="group" aria-label="Andhra Pradesh district map" class="mx-auto h-auto w-full min-w-[620px] sm:min-w-0"></svg></div>
    <section id="panel" class="card lg:max-h-[44rem] lg:overflow-auto" aria-live="polite">
      <p class="muted"><T en="Select a district on the map." te="పటంలో జిల్లాను ఎంచుకోండి." /></p>
    </section>
  </div>
  <p class="mt-4 text-xs muted"><T en="Simplified map: borders are indicative, not official. Districts are detected from place names in the headline or link, so headlines that name no district are not shown here. Boundaries: udit-001/india-maps-data (community-curated from public sources)." te="సరళీకృత పటం: సరిహద్దులు సూచనాత్మకం, అధికారికం కావు. శీర్షిక లేదా లింక్‌లోని ప్రాంతాల పేర్ల ఆధారంగా జిల్లాను గుర్తిస్తాం; జిల్లా పేరు లేని శీర్షికలు ఇక్కడ కనిపించవు. సరిహద్దుల మూలం: udit-001/india-maps-data (ప్రజా వనరుల నుండి సేకరించినది)." /></p>
</Base>

<script>
  import { dual, esc, getJSON, lang, timeAgo, ui, type Headline } from '../scripts/lib';
  import { DISTRICT_TE, TOPIC_COLOR, TOPIC_ORDER, topicLabel } from '../lib/i18n';
  import { AP_DISTRICTS, AP_MAP_SIZE } from '../lib/ap-map';

  const $ = <T extends HTMLElement | SVGElement>(id: string) => document.getElementById(id) as unknown as T;
  const svg = $<SVGSVGElement>('map'), panel = $('panel'), topicSel = $<HTMLSelectElement>('topic'), legend = $('legend'), statsEl = $('stats');
  let items: Headline[] = [];
  let topic = new URLSearchParams(location.search).get('topic') ?? '';
  let selected = '';

  const inScope = () => items.filter((i) => i.district && (!topic || i.topic === topic));
  const split = (s: string) => {
    const w = s.split(' ');
    return w.length > 1 && s.length > 9 ? [w.slice(0, Math.ceil(w.length / 2)).join(' '), w.slice(Math.ceil(w.length / 2)).join(' ')] : [s];
  };
  const color = (t: string) => TOPIC_COLOR[t] ?? TOPIC_COLOR.general;

  function buildTopic() {
    const te = lang() === 'te';
    const present = new Set(items.map((i) => i.topic));
    topicSel.innerHTML = `<option value="">${ui('All topics', 'అన్ని అంశాలు')}</option>` +
      TOPIC_ORDER.filter((t) => present.has(t)).map((t) => `<option value="${t}"${t === topic ? ' selected' : ''}>${topicLabel(t)[te ? 1 : 0]}</option>`).join('');
  }

  /** district -> { total, dominant topic } for the current scope */
  function summarise() {
    const byD = new Map<string, Map<string, number>>();
    inScope().forEach((i) => {
      const m = byD.get(i.district!) ?? new Map<string, number>();
      m.set(i.topic, (m.get(i.topic) ?? 0) + 1);
      byD.set(i.district!, m);
    });
    const out = new Map<string, { n: number; top: string }>();
    byD.forEach((m, d) => {
      const n = [...m.values()].reduce((a, b) => a + b, 0);
      const ranked = [...m.entries()].sort((a, b) => b[1] - a[1]);
      // prefer a real topic over "general" when both exist
      const top = (ranked.find(([t]) => t !== 'general') ?? ranked[0])![0];
      out.set(d, { n, top });
    });
    return out;
  }

  function drawStats(sum: Map<string, { n: number; top: string }>) {
    const total = [...sum.values()].reduce((a, v) => a + v.n, 0);
    const busiest = [...sum.entries()].sort((a, b) => b[1].n - a[1].n)[0];
    const chip = (h: string) => `<span class="stat-chip">${h}</span>`;
    statsEl.innerHTML = chip(`<b>${sum.size}</b> ${dual('districts in the news', 'జిల్లాలు వార్తల్లో')}`) +
      chip(`<b>${new Intl.NumberFormat('en-IN').format(total)}</b> ${dual('place-tagged headlines', 'ప్రాంతం గుర్తించిన శీర్షికలు')}`) +
      (busiest ? chip(`🔥 ${dual('Busiest', 'ఎక్కువ వార్తలు')}: <b>${dual(busiest[0], DISTRICT_TE[busiest[0]] ?? busiest[0])}</b>`) : '');
  }

  function drawLegend(sum: Map<string, { n: number; top: string }>) {
    const used = new Set([...sum.values()].map((v) => v.top));
    legend.innerHTML = TOPIC_ORDER.filter((t) => used.has(t))
      .map((t) => `<span class="inline-flex items-center gap-1.5" style="--tc:${color(t)}"><span class="legend-dot"></span>${dual(...topicLabel(t))}</span>`).join('');
  }

  const MARGIN = 120; // room on the right for callout labels of districts too small to hold their name
  const rightEdge = (d: string) => {
    let m = 0;
    for (const [, x] of d.matchAll(/(\d+\.\d) (\d+\.\d)/g)) m = Math.max(m, Number(x));
    return m;
  };
  const edges = Object.fromEntries(Object.entries(AP_DISTRICTS).map(([k, v]) => [k, rightEdge(v.d)]));

  function draw() {
    const sum = summarise();
    const max = Math.max(1, ...[...sum.values()].map((v) => v.n));
    drawStats(sum);
    drawLegend(sum);
    const te = lang() === 'te';
    svg.setAttribute('viewBox', `0 0 ${AP_MAP_SIZE.w + MARGIN} ${AP_MAP_SIZE.h}`);
    const shapes: string[] = [], labels: string[] = [];
    const callouts: { name: string; label: string; n: number; x: number; y: number; edge: number }[] = [];
    // paint the selected district last so its outline is not covered by neighbours
    const order = Object.keys(AP_DISTRICTS).sort((a, b) => Number(a === selected) - Number(b === selected));
    for (const name of order) {
      const g = AP_DISTRICTS[name]!;
      const info = sum.get(name);
      const n = info?.n ?? 0;
      const c = color(info?.top ?? 'general');
      const t = n / max, strong = t > 0.5;
      const fill = n ? `fill="${c}" fill-opacity="${(0.22 + 0.78 * t).toFixed(2)}"` : `fill="currentColor" fill-opacity=".05"`;
      const label = te ? DISTRICT_TE[name] ?? name : name;
      shapes.push(`<path class="dist${selected === name ? ' dist-sel' : ''}" tabindex="0" role="button" data-d="${esc(name)}" aria-label="${esc(name)}: ${n}"
        d="${g.d}" fill-rule="evenodd" ${fill}><title>${esc(name)}: ${n}</title></path>`);
      if (g.r < 14) { // too small for its name: label it in the sea with a leader line
        callouts.push({ name, label, n, x: g.x, y: g.y, edge: edges[name]! });
        labels.push(`<circle cx="${g.x}" cy="${g.y}" r="1.9" fill="${strong ? '#fff' : 'currentColor'}" class="dist-label" />`);
        continue;
      }
      const fs = Math.max(6, Math.min(11, g.r * 0.5));
      const words = label.split(' ');
      const lines = te || words.length === 1 || label.length <= 9 ? [label]
        : [words.slice(0, Math.ceil(words.length / 2)).join(' '), words.slice(Math.ceil(words.length / 2)).join(' ')];
      const ink = strong ? '#fff' : 'currentColor';
      const total = lines.length + 1, lh = fs * 1.15, y0 = g.y - ((total - 1) * lh) / 2;
      labels.push(`<g class="dist-label" fill="${ink}" text-anchor="middle">
        ${lines.map((ln, i) => `<text x="${g.x}" y="${(y0 + i * lh + fs * 0.35).toFixed(1)}" font-size="${fs.toFixed(1)}" font-weight="650">${esc(ln)}</text>`).join('')}
        <text x="${g.x}" y="${(y0 + lines.length * lh + fs * 0.35).toFixed(1)}" font-size="${(fs * 0.95).toFixed(1)}" font-weight="700" opacity="${n ? '.9' : '.45'}">${n}</text></g>`);
    }
    // callouts: keep them in vertical order with a minimum gap so they never overlap
    callouts.sort((a, b) => a.y - b.y);
    let prev = -Infinity;
    const placed = callouts.map((c) => { prev = Math.max(c.y, prev + 15); return { ...c, ly: prev }; });
    const over = (placed.at(-1)?.ly ?? 0) - (AP_MAP_SIZE.h - 10);
    if (over > 0) placed.forEach((c) => (c.ly -= over));
    const call = placed.map((c) => {
      const tx = c.edge + 14;
      return `<g class="callout"><line x1="${c.x}" y1="${c.y}" x2="${tx - 3}" y2="${(c.ly - 3).toFixed(1)}" stroke="currentColor" stroke-opacity=".4" stroke-width=".8" stroke-dasharray="2 2" />
        <text x="${tx}" y="${c.ly.toFixed(1)}" font-size="10" font-weight="600" fill="currentColor">${esc(c.label)} <tspan font-weight="800" fill-opacity=".75">${c.n}</tspan></text></g>`;
    }).join('');
    svg.innerHTML = `<text x="${AP_MAP_SIZE.w + MARGIN - 16}" y="${AP_MAP_SIZE.h - 16}" text-anchor="end" font-size="12" font-style="italic" fill="currentColor" opacity=".28">${te ? 'బంగాళాఖాతం' : 'Bay of Bengal'}</text>${shapes.join('')}${labels.join('')}<g class="dist-label" style="paint-order:normal;stroke:none">${call}</g>`;
  }

  function show(name: string) {
    selected = name;
    draw();
    const rows = inScope().filter((i) => i.district === name);
    panel.innerHTML = `<h2 class="text-2xl font-bold tracking-tight"><span class="grad-text">${dual(name, DISTRICT_TE[name] ?? name)}</span></h2>
      <p class="mb-3 mt-0.5 text-xs muted">${rows.length} ${dual('headlines', 'శీర్షికలు')}</p>
      ${rows.length ? `<div class="grid gap-2.5">${rows.slice(0, 40).map((i) => `
        <a class="news-card t-${i.topic} !py-3" href="${esc(i.url)}" target="_blank" rel="noopener noreferrer">
          <span class="block text-[15px] font-semibold leading-snug" lang="${i.language}">${esc(i.title)}</span>
          <span class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs muted">
            <span class="font-medium text-[#3a3a3c] dark:text-[#d1d1d6]">${esc(i.source_name)}</span><span aria-hidden="true">·</span><span>${timeAgo(i.published)}</span>
            ${i.topic !== 'general' ? `<span class="tag">${dual(...topicLabel(i.topic))}</span>` : ''}
            <span class="go ml-auto" aria-hidden="true">↗</span>
          </span></a>`).join('')}</div>`
        : `<p class="muted">${dual('No headlines for this district yet.', 'ఈ జిల్లాకు శీర్షికలు ఇంకా లేవు.')}</p>`}
      <p class="mt-4"><a class="btn no-underline" href="/?district=${encodeURIComponent(name)}${topic ? `&topic=${topic}` : ''}">${dual('Open in the main list', 'ప్రధాన జాబితాలో చూడండి')}</a></p>`;
  }

  const pick = (e: Event) => (e.target as Element).closest('[data-d]')?.getAttribute('data-d');
  svg.addEventListener('click', (e) => { const d = pick(e); if (d) show(d); });
  svg.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') { const d = pick(e); if (d) { e.preventDefault(); show(d); } } });
  topicSel.addEventListener('change', () => { topic = topicSel.value; selected ? show(selected) : draw(); });
  window.addEventListener('langchange', () => { buildTopic(); selected ? show(selected) : draw(); });

  getJSON<{ articles: Headline[] }>('latest.json')
    .then((d) => { items = d.articles ?? []; buildTopic(); draw(); })
    .catch(() => { panel.innerHTML = `<p class="muted">${dual('No data yet.', 'ఇంకా డేటా లేదు.')}</p>`; });
</script>
